# ===========================================================================
# DocuMind RAG Platform - Environment Configuration Template
# ===========================================================================
#
# NOTE: This file is an example only. Never commit real credentials.
# Copy to .env and fill in your actual values, or set environment variables.
# .env is gitignored (see .gitignore).
# ===========================================================================

# --- Google Gemini API (Required for Generation & Embeddings) ---------------
# Obtain your free API key at https://aistudio.google.com/
# Get: GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_API_KEY=your_actual_gemini_api_key_here

# LLM Generation Model (gemini-flash-latest or gemini-3.6-flash)
GEMINI_MODEL=gemini-flash-latest

# Embeddings Model (gemini-embedding-001 or text-embedding-004)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM Sampling Parameters
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT=120
LLM_PROVIDER=gemini

# --- Document & Storage Limits ----------------------------------------------
# Maximum file upload size in Megabytes
MAX_FILE_SIZE_MB=25

# --- Retrieval & Reranker Settings ------------------------------------------
# Number of initial candidate chunks retrieved before re-ranking
RETRIEVAL_CANDIDATES=14

# Final top chunks passed in context to Gemini after re-ranking
FINAL_CONTEXT_CHUNKS=6

# Enable Cross-Encoder Re-Ranking (cross-encoder/ms-marco-MiniLM-L-6-v2)
ENABLE_RERANKER=true

# Embedding Provider: 'gemini' (preferred) or 'local' (SentenceTransformers)
EMBEDDING_PROVIDER=gemini

# Debug telemetry logging
RAG_DEBUG=false

# --- Database (Supabase Postgres + pgvector) --------------------------------
# Get this from: Supabase Dashboard -> Project Settings -> Database ->
# Connection string URI format -> "Transaction" pooler mode
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres.soexroyzurzkusgvsmmz:DocuMind123DocuMind@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# --- CORS Configuration -----------------------------------------------------
# Comma-separated list of allowed origins, e.g. CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173