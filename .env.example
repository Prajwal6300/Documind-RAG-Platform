# ===========================================================================
# DocuMind RAG Platform — Environment Configuration Template
# ===========================================================================

# --- Google Gemini API (Required for Generation & Embeddings) ---------------
# Obtain your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here

# LLM Generation Model (gemini-2.5-flash, gemini-1.5-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Model (gemini-embedding-001 or text-embedding-004)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM Sampling Parameters
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT=120
LLM_PROVIDER=gemini

# --- Document & Storage Limits ----------------------------------------------
# Maximum file upload size in Megabytes
MAX_FILE_SIZE_MB=25

# --- Retrieval & Reranker Settings ------------------------------------------
# Number of initial candidate chunks retrieved before re-ranking
RETRIEVAL_CANDIDATES=16

# Final top chunks passed in context to Gemini after re-ranking
FINAL_CONTEXT_CHUNKS=6

# Enable Cross-Encoder Re-Ranking (cross-encoder/ms-marco-MiniLM-L-6-v2)
ENABLE_RERANKER=true

# Embedding Provider: 'gemini' (preferred) or 'local' (SentenceTransformers)
EMBEDDING_PROVIDER=gemini

# Debug telemetry logging
RAG_DEBUG=false

# --- Supabase Database (PostgreSQL + pgvector) ------------------------------
# Format A: Supabase Transaction Pooler (port 6543) - Recommended for persistent backend servers
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Format B: Supabase Session Pooler (port 5432)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Format C: Direct Postgres Connection
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres